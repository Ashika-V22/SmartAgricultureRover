{
  "expo": {
    "name": "SmartAgricultureRover",
    "slug": "SmartAgricultureRover",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE"
      ],
      "package": "com.anonymous.SmartAgricultureRover"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "with-rn-bluetooth-classic",
        {
          "peripheralUsageDescription": "Allow Smart Agriculture Rover to use Bluetooth",
          "alwaysUsageDescription": "Allow Smart Agriculture Rover to connect to the rover",
          "protocols": [
            "com.smartagriculturerover.bluetooth"
          ]
        }
      ],
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d5f9df3a-25ca-41ad-9806-17813e15e2e2"
      }
    }
  }
}
